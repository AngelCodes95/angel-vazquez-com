---

---

<form id="contact-form" class="flex flex-col gap-3" novalidate>
  <div class="flex flex-col gap-1">
    <label
      for="contact-name"
      class="font-mono text-[0.8125rem] text-[var(--text-subtle)] uppercase"
      >Name</label
    >
    <input
      id="contact-name"
      name="name"
      type="text"
      required
      class="border-b border-[var(--border)] bg-transparent px-0 py-2 font-mono text-[1.0625rem] text-[var(--text)] focus:border-[var(--accent)] focus-visible:outline-none"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label
      for="contact-email"
      class="font-mono text-[0.8125rem] text-[var(--text-subtle)] uppercase"
      >Email</label
    >
    <input
      id="contact-email"
      name="email"
      type="email"
      required
      class="border-b border-[var(--border)] bg-transparent px-0 py-2 font-mono text-[1.0625rem] text-[var(--text)] focus:border-[var(--accent)] focus-visible:outline-none"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label
      for="contact-message"
      class="font-mono text-[0.8125rem] text-[var(--text-subtle)] uppercase"
      >Message</label
    >
    <textarea
      id="contact-message"
      name="message"
      rows="4"
      required
      class="resize-none border-b border-[var(--border)] bg-transparent px-0 py-2 font-mono text-[1.0625rem] text-[var(--text)] focus:border-[var(--accent)] focus-visible:outline-none"
    ></textarea>
  </div>

  <button
    id="contact-submit"
    type="submit"
    class="mt-2 self-start font-mono text-[1.0625rem] font-semibold text-[var(--accent)] transition-opacity hover:opacity-70 disabled:opacity-40"
  >
    Send message &rarr;
  </button>

  <p
    id="contact-status"
    class="m-0 font-mono text-[0.9375rem]"
    role="status"
    aria-live="polite"
  >
  </p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById(
    'contact-submit'
  ) as HTMLButtonElement;
  const status = document.getElementById('contact-status');
  const endpoint = import.meta.env.PUBLIC_CONTACT_API_URL;

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (status === null) return;

    if (endpoint === undefined || endpoint === '') {
      status.textContent =
        'Contact form is not connected yet. Email me directly for now.';
      status.style.color = 'var(--text-muted)';
      return;
    }

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      message: String(formData.get('message') ?? ''),
    };

    submitButton.disabled = true;
    status.textContent = 'Sending...';
    status.style.color = 'var(--text-muted)';

    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then((response) => {
        if (!response.ok) throw new Error('Request failed');
        status.textContent = 'Message sent. I will get back to you soon.';
        status.style.color = 'var(--accent)';
        form.reset();
      })
      .catch(() => {
        status.textContent = 'Something went wrong. Please try again.';
        status.style.color = 'var(--text-muted)';
      })
      .finally(() => {
        submitButton.disabled = false;
      });
  });
</script>
