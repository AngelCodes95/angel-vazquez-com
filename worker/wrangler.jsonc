{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angel-vazquez-contact-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
  "vars": {
    // TODO(angel): must be an address on a domain you've onboarded via
    // `npx wrangler email sending enable yourdomain.com`.
    "CONTACT_FROM_EMAIL": "contact@angel-vazquez.com",
    // TODO(angel): where form submissions land. Can be your secondary inbox.
    "CONTACT_DESTINATION_EMAIL": "you@example.com",
  },
}
