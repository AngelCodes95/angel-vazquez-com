{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angel-vazquez-contact-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "vars": {
    // Must be an address on a domain you've verified with Resend
    // (resend.com/domains). The visitor's own address goes in reply-to, so
    // this address itself is never shown to them, it just needs to exist.
    "CONTACT_FROM_EMAIL": "contact@angel-vazquez.com",
    "CONTACT_DESTINATION_EMAIL": "ask.about.web.dev@gmail.com",
  },
  // RESEND_API_KEY is a secret, not a var: set it with
  // `npx wrangler secret put RESEND_API_KEY`, never written to this file.
}
